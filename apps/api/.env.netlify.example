# ─── Netlify deployment env vars (fill in real values in Netlify UI) ───
# Copy this to Netlify Environment Variables, do NOT commit secrets.

# Node
NODE_VERSION=22

# Server
PORT=4000
NODE_ENV=production

# Database (managed PostgreSQL e.g. Render, Aiven, Neon)
DATABASE_URL=

# Talocode Cloud public URLs
TALOCODE_BASE_URL=https://api.talocode.site
TALOCODE_WEB_URL=https://talocode.site
TALOCODE_MCP_URL=https://api.talocode.site/mcp
TALOCODE_DOCS_URL=https://docs.talocode.site

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# AI Providers (router fallback)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# GitHub (for Skills API data enrichment)
GITHUB_TOKEN=

# Agent Browser (optional Playwright host for screenshot/full browser checks)
# AGENT_BROWSER_SERVICE_URL=https://your-playwright-host.example.com
# AGENT_BROWSER_ALLOW_LOCALHOST=1

# Skills provider (optional: set to enable provider-assisted generation)
# TALOCODE_SKILLS_PROVIDER=

# Web origin (CORS) — primary fallback when Origin is not in the allowlist
WEB_ORIGIN=https://dashboard.talocode.site
# Optional extra origins (comma-separated). Defaults already include dashboard, stacklane, talocode.site, localhost.
# WEB_ORIGINS=https://dashboard.talocode.site,https://stacklane.talocode.site

# Lemon Squeezy (default payment provider for credit top-ups)
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_VARIANT_ID=
# LEMONSQUEEZY_VARIANT_MAP={"500":"...","1000":"...","2500":"...","5000":"...","10000":"...","25000":"..."}
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_TEST_MODE=false
# TALOCODE_PAYMENT_PROVIDER=lemonsqueezy
# TALOCODE_CLOUD_SUCCESS_URL=https://dashboard.talocode.site/billing?topup=success
# TALOCODE_CLOUD_CANCEL_URL=https://dashboard.talocode.site/billing?topup=cancel
